#!/bin/sh
# Wrapper sencillo de Maven (Linux/macOS).
# Descarga Apache Maven la primera vez y luego lo reutiliza. No requiere tener Maven instalado.
set -e

MAVEN_VERSION=3.9.11
DIST_DIR="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists/apache-maven-$MAVEN_VERSION"
MVN_BIN="$DIST_DIR/bin/mvn"

if [ ! -x "$MVN_BIN" ]; then
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  TMP_DIR=$(mktemp -d)
  echo "Descargando Apache Maven $MAVEN_VERSION ..."
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$URL" -o "$TMP_DIR/maven.tar.gz"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$TMP_DIR/maven.tar.gz"
  else
    echo "Error: se necesita curl o wget para descargar Maven." >&2
    exit 1
  fi
  tar -xzf "$TMP_DIR/maven.tar.gz" -C "$TMP_DIR"
  mkdir -p "$(dirname "$DIST_DIR")"
  rm -rf "$DIST_DIR"
  mv "$TMP_DIR/apache-maven-$MAVEN_VERSION" "$DIST_DIR"
  rm -rf "$TMP_DIR"
fi

exec "$MVN_BIN" "$@"
